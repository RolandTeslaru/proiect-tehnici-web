<header>
    <h1><i class="fas fa-shield-halved"></i> Aegis Dynamics: Lider in solutii de aparare</h1>
    <nav id="main-nav">
        <input type="checkbox" id="burger-menu-toggle" aria-label="Toggle menu">
        <label for="burger-menu-toggle" class="burger-menu-icon" aria-label="Deschide meniu">
            <div class="hamburger-container">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </div>
        </label>
        <ul class="menu-list">
            <li class="menu-item link-acasa">
                <a href="/">
                    <i class="fa-solid fa-house"></i>
                    <span class="menu-text">Acasa</span>
                </a>
                <ul class="submenu">
                    <li><a href="/index#viziune">Viziune si Inovatie</a></li>
                    <li><a href="/index#proiecte">Stadiu Proiecte</a></li>
                    <li><a href="/index#evenimente">Evenimente Oficiale</a></li>
                    <li><a href="/index#zona8">Resurse si Media</a></li>
                </ul>
            </li>
            <li class="menu-item link-produse">
                <a href="/produse">
                    <i class="fa-solid fa-box"></i>
                    <span class="menu-text">Produse</span>
                </a>
                <ul class="submenu">
                    <li><a href="/produse">Toate</a></li>
                    <% (locals.categoriiProduse || []).forEach(function(categ) { %>
                        <li><a href="/produse?categorie=<%= categ %>"><%= categ.charAt(0).toUpperCase() + categ.slice(1) %></a></li>
                    <% }); %>
                </ul>
            </li>
            <li class="menu-item link-portofoliu">
                <a href="#">
                    <i class="fa-solid fa-briefcase"></i>
                    <span class="menu-text">Divizii si Servicii</span>
                </a>
                <ul class="submenu">
                    <li><a href="/contractare">Contractare Guvernamentala (FMS)</a></li>
                    <li><a href="/cibernetic">Securitate Cibernetica (Pilot)</a></li>
                </ul>
            </li>
            <li class="menu-item link-despre">
                <a href="/despre">
                    <i class="fa-solid fa-circle-info"></i>
                    <span class="menu-text">Despre Noi</span>
                </a>
            </li>
            <li class="menu-item link-contact">
                <a href="/contact">
                    <i class="fa-solid fa-envelope"></i>
                    <span class="menu-text">Portal Securizat / Contact</span>
                </a>
            </li>
            <li class="menu-item link-anunturi">
                <a href="/index#anunturi">
                    <i class="fa-solid fa-bell"></i>
                    <span class="menu-text">Anunturi Importante</span>
                </a>
            </li>
            <!-- e6b19 - buton orar in navbar, vizibil pe orice pagina -->
            <li class="menu-item">
                <button id="btn-orar" type="button" title="Vezi orarul de functionare">
                    <i class="fa-solid fa-clock"></i>
                    <span class="menu-text">Orar</span>
                </button>
            </li>
        </ul>
    </nav>
    <!-- e6b2 - select cu 3 teme in loc de toggle light/dark -->
    <div id="comutator-tema-container" title="Alege tema">
        <i class="fa-solid fa-palette" aria-hidden="true"></i>
        <select id="comutator-tema" aria-label="Alege tema">
            <option value="dark">Dark</option>
            <option value="light">Light</option>
            <option value="tactical">Tactical</option>
        </select>
    </div>
    <!-- <div id="user-info">
        <p>IP-ul tau: <%= locals.ip %></p>
    </div> -->
    <!-- <p>Expertiza <strong>B2G</strong> pentru excelenta si <strong>inovatie militara</strong> globala.</p> -->
</header>
