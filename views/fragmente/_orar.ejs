<%
// e6b19 - orar de functionare, randat server-side ca fragment
// indexul zilei: 0=Luni ... 5=Sambata, 6=Duminica (corespunde cu getDay() convertit in orar.js)
var orar = [
    { zi: "Luni",      start: 8,  end: 17 },
    { zi: "Marti",     start: 8,  end: 17 },
    { zi: "Miercuri",  start: 8,  end: 17 },
    { zi: "Joi",       start: 8,  end: 17 },
    { zi: "Vineri",    start: 8,  end: 15 },
    { zi: "Sambata",   start: 9,  end: 13 },
    { zi: "Duminica",  start: null, end: null }
];
%>

<div id="orar-overlay" aria-modal="true" role="dialog" aria-label="Orar de functionare" hidden>
    <div id="orar-panel">
        <div id="orar-header">
            <h3>Orar de Functionare</h3>
            <button id="orar-inchide" aria-label="Inchide orarul">&times;</button>
        </div>

        <table id="orar-tabel">
            <thead>
                <tr>
                    <th>Zi</th>
                    <th>Program</th>
                </tr>
            </thead>
            <tbody>
                <% orar.forEach(function(rand, i) { %>
                <tr data-zi="<%= i %>"
                    data-start="<%= rand.start !== null ? rand.start : -1 %>"
                    data-end="<%= rand.end !== null ? rand.end : -1 %>">
                    <td><%= rand.zi %></td>
                    <td>
                        <% if (rand.start !== null) { %>
                            <%= String(rand.start).padStart(2,'0') %>:00 &ndash; <%= String(rand.end).padStart(2,'0') %>:00
                        <% } else { %>
                            Inchis
                        <% } %>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>

        <p id="orar-status"></p>
    </div>
</div>
