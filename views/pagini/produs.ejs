<!DOCTYPE html>
<html lang="ro">

<head>
    <title><%= produs.nume %> | Aegis Dynamics</title>
    <%- include("../fragmente/head") %>
</head>

<body id="top">
    <%- include("../fragmente/header") %>

    <%
    var zileRo = ["Duminica", "Luni", "Marti", "Miercuri", "Joi", "Vineri", "Sambata"];
    var luniRo = ["Ianuarie", "Februarie", "Martie", "Aprilie", "Mai", "Iunie",
                  "Iulie", "August", "Septembrie", "Octombrie", "Noiembrie", "Decembrie"];
    var d = new Date(produs.data_introducerii);
    // ISO din componente locale, ca sa nu se decaleze ziua din cauza UTC
    var dataIso = d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
    var dataRo = d.getDate() + "(" + zileRo[d.getDay()] + ")/" + luniRo[d.getMonth()] + "/" + d.getFullYear();
    %>

    <main class="layout-grid">
        <section id="produs-detaliu" class="produs <%= produs.categorie %>">
            <!-- e6b20 - buton comparare pe pagina produsului -->
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <h2 class="mb-0"><%= produs.nume %></h2>
                <button class="btn-compara" data-id="<%= produs.id %>" data-nume="<%= produs.nume %>" title="Compară acest produs">Compară</button>
            </div>

            <!-- e6b9 - carusel Bootstrap cu toate imaginile din folderul produsului -->
            <% if (imagini.length > 1) { %>
            <div id="carusel-produs" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    <% imagini.forEach(function(img, i) { %>
                        <button type="button" data-bs-target="#carusel-produs" data-bs-slide-to="<%= i %>" class="<%= i === 0 ? 'active' : '' %>"></button>
                    <% }); %>
                </div>
                <div class="carousel-inner">
                    <% imagini.forEach(function(img, i) { %>
                        <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
                            <img src="<%= img %>" class="produs-imagine-mare d-block" alt="<%= produs.nume %>">
                        </div>
                    <% }); %>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#carusel-produs" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carusel-produs" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
            <% } else { %>
            <img class="produs-imagine-mare" src="<%= imagini[0] || produs.imagine %>" alt="<%= produs.nume %>">
            <% } %>

            <p><%= produs.descriere %></p>

            <table class="produs-tabel-detaliu">
                <tbody>
                    <tr><th>Categorie</th><td><%= produs.categorie %></td></tr>
                    <tr><th>Tip livrare</th><td><%= produs.tip_livrare %></td></tr>
                    <tr><th>Pret</th><td><%= produs.pret %> EUR</td></tr>
                    <tr><th>Autonomie</th><td><%= produs.autonomie_km %> km</td></tr>
                    <tr><th>Data introducerii</th><td><time datetime="<%= dataIso %>"><%= dataRo %></time></td></tr>
                    <tr><th>Nivel clasificare</th><td><%= produs.nivel_clasificare %></td></tr>
                    <tr><th>Compatibilitati</th><td><%= produs.compatibilitati %></td></tr>
                    <tr><th>Export permis</th><td><%= produs.export_permis ? "Da" : "Nu" %></td></tr>
                </tbody>
            </table>

            <p><a href="/produse">&larr; Inapoi la catalog</a></p>
        </section>

        <!-- e6b16 - produse similare din aceeasi categorie -->
        <% if (locals.produseSimilare && produseSimilare.length) { %>
        <section id="produse-similare">
            <h3>Produse similare din categoria <em><%= produs.categorie %></em></h3>
            <ul class="lista-produse-similare">
                <% produseSimilare.forEach(function(ps) { %>
                <li>
                    <a href="/produs/<%= ps.id %>">
                        <img src="<%= ps.imagine %>" alt="<%= ps.nume %>" loading="lazy">
                        <span><%= ps.nume %></span>
                    </a>
                </li>
                <% }); %>
            </ul>
        </section>
        <% } %>
    </main>

    <%- include("../fragmente/footer") %>

    <%- include("../fragmente/_containerComparare") %>
    <script src="/resurse/js/comparare.js"></script>
</body>

</html>
